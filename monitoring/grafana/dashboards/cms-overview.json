{
  "title": "CMS Platform Overview",
  "uid": "cms-overview",
  "schemaVersion": 38,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP request rate (per app)",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (app)",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error rate",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{status=~\"5..\"}[1m])) by (app)",
          "legendFormat": "{{app}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Pods running",
      "gridPos": { "x": 0, "y": 8, "w": 6, "h": 6 },
      "targets": [
        {
          "expr": "sum(kube_pod_status_phase{namespace=\"cms\", phase=\"Running\"})"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "CPU usage by pod",
      "gridPos": { "x": 6, "y": 8, "w": 18, "h": 6 },
      "targets": [
        {
          "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"cms\"}[5m])) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory usage by pod",
      "gridPos": { "x": 0, "y": 14, "w": 24, "h": 6 },
      "targets": [
        {
          "expr": "sum(container_memory_working_set_bytes{namespace=\"cms\"}) by (pod)",
          "legendFormat": "{{pod}}"
        }
      ]
    }
  ]
}
